{
  "name": "breast-cancer-ai-platform",
  "version": "1.0.0",
  "description": "Multi-Modal Breast Cancer AI Analysis Platform - Desktop App & Web Version",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run start-backend\" \"npm run start-frontend\" \"wait-on http://localhost:3000 && electron .\"",
    "build-electron": "npm run build-frontend && electron-builder",
    "build-frontend": "cd frontend && npm run build",
    "start-frontend": "cd frontend && npm start",
    "start-backend": "python backend/main.py",
    "start-web": "concurrently \"npm run start-backend\" \"npm run start-frontend\"",
    "build-web": "npm run build-frontend",
    "install-deps": "cd frontend && npm install && cd .. && npm install",
    "package-app": "npm run build-frontend && electron-builder --publish=never"
  },
  "build": {
    "appId": "com.hospital.breastcancerai",
    "productName": "Breast Cancer AI Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/build/**/*",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  }
}